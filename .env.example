## gin服务配置
SERVER_ADDRESS=:8080

## 网页认证配置
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_HOUR=
REFRESH_TOKEN_EXPIRE_HOUR=

## MySQL数据库配置
MYSQL_DSN=new_user:123456@tcp(mysql:3306)/litstream?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai&interpolateParams=true

## Redis配置
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXPIRE_TIME=72
REDIS_IA_EXPIRE_TIME=14
REDIS_MAX_LEN=40

## Milvus配置
MILVUS_ADDRESS=milvus:19530
MILVUS_COLLECTION_NAME=litstream
VEC_DIM=1024


SEARCH_TOP_K=100
LIMIT_TOP_K=18
RECS_WINDOW=10

### 模型配置
# 后端自己的语言模型（ 当前请求格式只适配 DeepSeek，litstream 后端的 LLM 地址硬编码为 DeepSeek）
MODEL_NAME=deepseek-flash
MODEL_API_KEY=

# searcher 的文献介绍（summary）：千问 MaaS 的 qwen3.8-flash（OpenAI 兼容模式）
SUMMARY_MODEL_NAME=qwen3.8-flash
SUMMARY_MODEL_API_KEY=

# embedding
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding-flash
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_BASE_URL_WITH_OPENAI=https://dashscope.aliyuncs.com/compatible-mode/v1

### 翻译 provider 配置 提供阿里云机器翻译和百炼 Qwen-MT 两种翻译服务
# alimt  = 阿里云机器翻译通用版（默认）：RAM AccessKey 签名，额度 QPS 50
# qwenmt = 百炼 Qwen-MT：DashScope ApiKey，额度 60 RPM(≈1 RPS)，默认每秒放行 1 个
TRANSLATE_PROVIDER=qwenmt

# # alimt 的凭据（RAM AccessKey，与上面的 ApiKey 不是同一套）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# qwenmt 的凭据（选了 qwenmt 就必须填；QWEN_MT_MODEL 留空默认 qwen-mt-lite）
QWEN_MT_API_KEY=
QWEN_MT_MODEL=qwen-mt-lite

USER_NAME_TTL=72            # 原 REDIS_EXPIRE_TIME=72 (小时)
USER_INFO_TTL=72
ITEM_TTL=168
INTERACTION_TTL=336         # 原 REDIS_IA_EXPIRE_TIME=14 天
RECOMMEND_TTL=30            # 原 30 分钟
INTERACTION_RECORD_MAX_LEN=40
QUEUE_UNIQUE_TTL1=60
QUEUE_UNIQUE_TTL2=60

MYSQL_MAX_IDLE_CONNS=20
MYSQL_MAX_OPEN_CONNS=50
MYSQL_CONN_MAX_LIFETIME=30
MYSQL_CONN_MAX_IDLE_TIME=10

ENRICH_CONCURRENCY=64
SUMMARY_CONCURRENCY=64

LOG_LEVEL=info

MAIL_ACCOUNT_NAME=litstream@email.nexel.dpdns.org